{
  "name": "@bemedev/decompose",
  "version": "2.3.0",
  "description": "Decompose object and so more",
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/decompose"
  },
  "homepage": "https://github.com/chlbri/decompose/blob/main/packages/decompose/README.md",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "keywords": [
    "For",
    "creating",
    "new",
    "npm",
    "package"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "public"
  ],
  "scripts": {
    "build": "pnpm run rm:lib && pnpm run rolldown",
    "build:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run build",
    "_ci": "pnpm run lint && pnpm run test",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "lint:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run lint",
    "p-q": "pretty-quick",
    "posttest": "pnpm run fmt && pnpm build-tests post",
    "pretest": "pnpm run build && pnpm build-tests pre",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rinit": "pnpm run rm && pnpm run config",
    "rinit:off": "pnpm run rm && pnpm run config:off",
    "rimraf": "pnpm dlx rimraf -rf",
    "rm": "pnpm run rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "pnpm run rimraf ./lib",
    "rolldown": "rolldown -c",
    "test:coverage": "vitest run",
    "test": "pnpm run test:coverage --no-coverage",
    "test:no-type": "pnpm run test:coverage -c \"vitest.config.notype.ts\" --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:ui": "vitest --ui",
    "test:type": "pnpm run test:coverage -c \"vitest.config.type.ts\" --no-coverage",
    "test:type:watch": "vitest -c \"vitest.config.type.ts\"",
    "test:watch": "pnpm run pretest && vitest"
  },
  "devDependencies": {
    "@bemedev/build-tests": "^0.1.2",
    "@bemedev/dev-utils": "^1.1.1",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/sequence": "^1.0.0",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pretty-quick": "^4.2.2",
    "rolldown": "1.2.0",
    "rxjs": "^7.8.2",
    "tsc-alias": "^1.9.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ts-deepmerge": "^8.0.0"
  }
}
